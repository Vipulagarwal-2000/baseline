	"stable_schema_identity": true,
	"identity_field_is_explicit": true,
	"runtime_state_is_not_definition_authority": true,
	"reserved_domains_may_define_identity_only": true,
	"field_semantic_type_is_required": true,
	"source_paths_are_descriptive_not_runtime_state": true
  },
