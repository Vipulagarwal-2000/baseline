{
  "version": 1,
  "schema_registry_id": "world_simulator_canonical_schemas",
  "description": "Canonical domain schema contracts for Phase 3.4. This registry defines identity, shape, field semantics, and source/runtime boundaries without moving authoritative mutable state into JSON.",
