  "region_model": "historical_superregions_1950_mvp_v2",
  "description": "Historical 1950 PRC provincial-level structure grouped under the six Greater Administrative Areas used in the early PRC. The Greater Administrative Area layer was abolished in 1954, so these parent regions are retained only as stable simulation geography; the historical transition timeline records the 1952-1955 administrative changes.",
  "source_basis": [
	"1950 PRC administrative-division chronology (29 provinces, 1 autonomous region, 13 municipalities, 8 administrative-office regions, plus separate Tibet/Qamdo/Taiwan status).",
	"Library of Congress/CIA map: China, communist administrative divisions, December 1954.",
    "1952 Resolution on adjustment of provincial and regional establishments; 1954 abolition of Greater Administrative Areas and provincial mergers; 1955 Rehe/Xikang/Xinjiang changes."
  ],
  "historical_transition_events": [
	{
	  "date": "1952-11-15",
	  "event": "provincial_reorganization",
	  "details": "Pingyuan and Chahar abolished into surrounding provinces; Jiangsu, Anhui and Sichuan restored as provinces; Nanjing loses central-municipality status and becomes part of Jiangsu."
	},
	{
	  "date": "1953-02-01",
	  "event": "municipality_change",
	  "details": "Changchun and Harbin elevated to provincial-level municipalities."
	},
	{
	  "date": "1954-06-19",
	  "event": "regional_reorganization",
	  "details": "Six Greater Administrative Areas abolished; Liaodong and Liaoxi merged into Liaoning; Songjiang merged into Heilongjiang; Suiyuan merged into Inner Mongolia; Ningxia merged into Gansu; most provincial-level municipalities absorbed, leaving Beijing, Shanghai and Tianjin as direct municipalities."
	},
	{
	  "date": "1955-07-30",
	  "event": "provincial_reorganization",
	  "details": "Rehe abolished and divided among Hebei, Liaoning and Inner Mongolia; Xikang incorporated mainly into Sichuan."
	},
	{
	  "date": "1955-10-01",
	  "event": "autonomy_change",
	  "details": "Xinjiang Province became Xinjiang Uyghur Autonomous Region."
	}
  ],
