{
  "version": 1,
  "registry_id": "world_simulator_versioning_registry",
  "description": "Declarative version-control metadata for inventoried World Simulator data assets. Phase 3.7 establishes explicit version identity without inventing historical version numbers for pre-existing baseline content.",
  "policy": {
	"every_inventoried_path_requires_exactly_one_record": true,
	"versioning_metadata_is_not_runtime_state": true,
	"baseline_assets_must_explicitly_mark_unversioned_history": true,
	"controlled_assets_require_semver_label": true,
	"schema_version_must_be_positive_integer": true,
	"previous_version_must_be_null_for_initial_control_record": true,
	"domain_and_asset_type_must_match_inventory": true,
	"duplicate_paths_are_invalid": true,
	"effective_date_must_be_iso_date": true,
	"compatibility_policy_must_be_explicit": true
  },
  "allowed_version_statuses": [
	"controlled",
    "baseline_unversioned"
  ],
  "allowed_revision_states": [
	"controlled",
    "explicit_baseline"
  ],
  "allowed_lifecycle_statuses": [
	"active",
	"deprecated",
    "retired"
  ],
  "allowed_compatibility_policies": [
	"same_schema_or_explicit_migration_required",
	"breaking_change_requires_migration",
    "metadata_only_change"
  ],
  "coverage": {
	"inventory_path_count": 39,
	"version_record_count": 39,
	"status": "complete_for_current_inventory"
  },
