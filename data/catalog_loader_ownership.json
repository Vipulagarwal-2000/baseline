{
  "version": 1,
  "registry_id": "world_simulator_catalog_loader_ownership",
  "description": "Declarative ownership contracts for domain definition catalogs and loader pathways. Phase 3.8 makes one authoritative catalog/loader ownership decision per canonical domain without introducing a generic DataManager or moving runtime state into definition data.",
  "policy": {
	"every_canonical_domain_requires_exactly_one_record": true,
	"catalog_loader_ownership_is_control_plane_metadata": true,
	"domain_and_schema_status_must_agree": true,
	"domain_and_ownership_status_must_agree": true,
	"reserved_domains_must_remain_identity_only": true,
	"source_paths_must_agree_with_canonical_schema": true,
	"loader_contract_must_be_explicit": true,
	"generic_data_manager_is_forbidden": true,
	"duplicate_loader_contracts_are_allowed_when_ownership_is_explicit": true,
	"runtime_state_is_not_loaded_from_definition_catalogs": true
  },
  "allowed_ownership_modes": [
	"catalog",
	"runtime_definition",
	"reference",
    "reserved_identity_only"
  ],
  "allowed_loader_modes": [
	"explicit_existing_loader",
	"explicit_runtime_definition",
	"catalog_owned_reference_resolution",
	"contract_named_not_dedicated_file",
    "reserved_identity_only"
  ],
  "allowed_authority_statuses": [
	"active",
	"partial",
    "reserved_unmodeled"
  ],
  "coverage": {
	"canonical_domain_count": 17,
	"ownership_record_count": 17,
	"status": "complete_for_current_canonical_domains"
  },
