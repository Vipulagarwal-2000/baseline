{
  "version": 1,
  "registry_id": "world_simulator_referential_integrity_rules",
  "description": "Declarative cross-domain reference rules for Phase 3.5. Rules audit existing data; they do not create runtime state or new domain content.",
  "policy": {
	"target_must_exist_in_canonical_registry": true,
	"empty_reference_is_invalid": true,
	"reserved_unmodeled_target_must_not_be_fabricated": true,
	"runtime_state_is_not_created_by_audit": true,
	"duplicate_reference_use_is_allowed": true,
	"source_paths_are_explicit": true
  },
  "allowed_modes": [
	"value",
	"map_keys",
	"root_map_keys",
	"array_item_field",
	"array_map_keys",
	"nested_root_map_keys",
    "array_item_field_nested"
  ],
